# Пока эти переменные пустые, сайт работает на локальной демо-базе (localStorage).
# После подключения Supabase заполнить и перезапустить / задеплоить.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Email админа, созданного в Supabase → Authentication → Users
VITE_ADMIN_EMAIL=admin@only.vision
# Пароль админки для ДЕМО-режима (без Supabase)
VITE_DEMO_ADMIN_PASSWORD=onlyvision
